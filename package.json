{
    "name": "@fp8/simple-config",
    "version": "0.7.1",
    "description": "Simple Config Reader",
    "main": "lib/index.js",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fp8/simple-config.git"
    },
    "author": "marcos.lin@farport.co",
    "license": "MIT",
    "private": false,
    "types": "lib/index.d.ts",
    "scripts": {
        "build:ts": "tsc --project src/tsconfig.json",
        "build": "yarn lint && yarn build:ts && yarn test:lib && yarn gendoc",
        "gendoc": "OUTPUTDIR=build/docs && mkdir -p $OUTPUTDIR && typedoc --readme none --excludePrivate --tsconfig src/tsconfig.json --out $OUTPUTDIR src/index.ts",
        "lint:format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "lint:ts": "eslint \"{src,test}/**/*.ts\" --fix",
        "lint": "yarn lint:ts && yarn lint:format",
        "info:version": "node scripts/packageInfo.js",
        "test:lib": "dotenvx run -f .env.test -- jest --config ./jest.config.lib.ts",
        "test:unit": "dotenvx run -f .env.test -- jest --config ./jest.config.ts",
        "test": "yarn test:unit --coverage",
        "utest": "yarn test:unit --runInBand --bail"
    },
    "devDependencies": {
        "@dotenvx/dotenvx": "^1.51.2",
        "@types/debug": "^4.1.7",
        "@types/jest": "^30.0.0",
        "@types/node": "^25.0.3",
        "@typescript-eslint/eslint-plugin": "^8.50.0",
        "@typescript-eslint/parser": "^8.50.0",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "jest": "^30.0.4",
        "prettier": "^3.7.4",
        "ts-jest": "^29.2.5",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typedoc": "^0.28.15",
        "typescript": "~5.9.3"
    },
    "dependencies": {
        "@types/mustache": "^4.2.5",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "jlog-facade": "^0.10.1",
        "mustache": "^4.2.0",
        "reflect-metadata": "^0.2.2",
        "yaml": "^2.7.0"
    },
    "peerDependencies": {
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "reflect-metadata": "^0.2.2"
    },
    "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
